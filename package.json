{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun run build.ts",
    "test:e2e": "bunx playwright test",
    "test:e2e:ui": "bunx playwright test --ui",
    "test:e2e:install": "bunx playwright install --with-deps",
    "test": "bun test",
    "test:unit": "bun test src/",
    "audit:agents": "bun run src/api/auditAgents.cli.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^2.0.112",
    "@clerk/backend": "^2.32.1",
    "@clerk/clerk-react": "^5.59.2",
    "@elevenlabs/react": "^0.14.1",
    "@fontsource/uncut-sans": "^5.2.5",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "ai": "^5.0.110",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.32.0",
    "lucide-react": "^0.545.0",
    "ogl": "^1.0.11",
    "react": "^19",
    "react-dom": "^19",
    "svix": "^1.86.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.4.0"
  }
}
